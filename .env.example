# Copy this file to .env and fill in the values for your machine.
# .env is gitignored — never commit it.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with your actual paths

# Path to the IsaacLab root directory (contains isaaclab.sh).
# Example for Isaac Sim 5.1 standalone on Linux:
ISAACLAB_PATH=/path/to/isaac-sim-standalone-5.1.0-linux-x86_64/IsaacLab
