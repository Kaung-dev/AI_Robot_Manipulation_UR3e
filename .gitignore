# --- Claude Code project metadata (do not push) --------------------------
.claude/

# --- ROS2 colcon build artifacts (huge; regenerated by `colcon build`) ---
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# --- Isaac Sim / Omniverse caches ----------------------------------------
.thumbs/
*.usd.png

# Generated USD output of fix_scene_for_isaaclab.py — recreated by setup_isaaclab.sh
scene/scene_isaaclab.usd

# USDs produced by scripts/export_pegboard_scene.py — Isaac Sim bakes the
# host's absolute paths into the references, so they don't survive `git push`.
# Regenerate locally per machine.
scene/pegboard_full.usd

# 3rd-party Isaac Sim demo scene + UR10e+Robotiq robot pulled from S3;
# the upstream scene contains absolute paths baked in by the original author.
# Re-download with commands in CAMERA_AND_TELEOP.md if you need them.
scene/isaac_manipulator_scene.usd
scene/ur10e_robotiq2f_140.usd

# Experimental robot USD from Isaac Sim's URDF importer GUI — not used by
# the current pegboard setup.
robot/

# Local environment config (machine-specific paths — do not commit)
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Logs / scratch from the inspector and fixer scripts
scripts/scene_inspection.json
scripts/scene_inspection.txt
scripts/fix_scene.log

# IDE / OS
.vscode/
.idea/
.DS_Store

# Datasets / checkpoints (keep out of git; use Git LFS or external storage if needed)
datasets/
logs/
runs/
*.hdf5
*.pth
