<?xml version="1.0" ?>
<robot name="rg2">

  <!-- Root: hand. When you add this to a scene, attach this link to the
       arm's wrist (or wherever you want it) by re-parenting in Isaac Sim. -->
  <link name="onrobot_base_link">
    <visual>
      <geometry>
        <mesh filename="meshes/rg2/hand.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/rg2/hand.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.78"/>
      <origin rpy="0 0 0" xyz="0.05 0 0"/>
      <inertia ixx="1.0E-3" ixy="0" ixz="0" iyy="1.0E-3" iyz="0" izz="1.0E-3"/>
    </inertial>
  </link>

  <!-- Driver-facing prismatic. Two finger joints mimic this with a linear ratio. -->
  <link name="finger_width_mock_link">
    <inertial>
      <mass value="0.001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="finger_width" type="prismatic">
    <parent link="onrobot_base_link"/>
    <child link="finger_width_mock_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.110" velocity="0.127" effort="40"/>
  </joint>

  <link name="onrobot_leftfinger">
    <visual>
      <geometry>
        <mesh filename="meshes/rg2/finger.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/rg2/finger.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>
  <link name="onrobot_rightfinger">
    <visual>
      <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/rg2/finger.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/rg2/finger.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <joint name="rg2_finger_joint1" type="revolute">
    <parent link="onrobot_base_link"/>
    <child link="onrobot_leftfinger"/>
    <origin xyz="0.105 0.017 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="1.18" effort="10.6" velocity="1.57"/>
    <mimic joint="finger_width" multiplier="10.727" offset="0"/>
  </joint>
  <joint name="rg2_finger_joint2" type="revolute">
    <parent link="onrobot_base_link"/>
    <child link="onrobot_rightfinger"/>
    <origin xyz="0.105 -0.017 0" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0.0" upper="1.18" effort="10.6" velocity="1.57"/>
    <mimic joint="finger_width" multiplier="10.727" offset="0"/>
  </joint>

  <link name="gripper_tcp"/>
  <joint name="gripper_tcp_joint" type="fixed">
    <parent link="onrobot_base_link"/>
    <child link="gripper_tcp"/>
    <origin xyz="0.218 0 0" rpy="0 0 0"/>
  </joint>

</robot>
